{
    "url": "https://seoscoreapi.com/usage",
    "method": "GET",
    "headers": {
        "X-API-Key": "{{parameters.apiKey}}",
        "User-Agent": "seoscoreapi-make/1.0.0"
    },
    "response": {
        "error": {
            "message": "[{{statusCode}}] {{ifempty(body.detail, ifempty(body.error, 'Request failed'))}}",
            "401": {
                "message": "Your SEO Score API key was not accepted. Check it on your dashboard at https://seoscoreapi.com/dashboard."
            }
        }
    },
    "log": {
        "sanitize": [
            "request.headers.x-api-key"
        ]
    }
}
